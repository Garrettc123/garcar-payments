# Garcar Enterprise — Cross-System Integration Environment Variables
# Copy to .env and fill in all values before running
# NEVER commit .env to git

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# REQUIRED: the Stripe webhook returns 503 (refuses all events) until this is set.
STRIPE_WEBHOOK_SECRET=whsec_...

# REQUIRED: API key for the internal read endpoints GET /mrr and GET /events.
# They return 503 until it is set. Send it as the X-API-Key header (or Authorization: Bearer).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENTS_ADMIN_API_KEY=

STRIPE_PRICE_IRAS_SETUP=price_...
STRIPE_PRICE_IRAS_MONTHLY=price_...
STRIPE_PRICE_OPF_AGENCY=price_...

# ── HubSpot ─────────────────────────────────────────────────────
HUBSPOT_TOKEN=pat-na1-...
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_NEW=appointmentscheduled
HUBSPOT_STAGE_CLOSED=closedwon

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Linear ──────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=...
LINEAR_ONBOARDING_TEMPLATE_ID=

# ── Notion ──────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_CLIENTS_DB_ID=...
NOTION_OPS_PAGE_ID=

# ── DocuSign ────────────────────────────────────────────────────
DOCUSIGN_ACCOUNT_ID=...
DOCUSIGN_ACCESS_TOKEN=...
DOCUSIGN_TEMPLATE_IRAS=...
DOCUSIGN_TEMPLATE_OPF=

# ── Hunter ──────────────────────────────────────────────────────
HUNTER_API_KEY=...

# ── Shopify ─────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
SHOPIFY_WEBHOOK_SECRET=

# ── Hugging Face ────────────────────────────────────────────────
HF_TOKEN=hf_...
HF_MODEL_REPO=Garrettc123/garcar-ops-model

# ── GitHub ──────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=Garrettc123
