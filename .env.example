# ── Stripe ────────────────────────────────────────────────────────────────
# Live key: https://dashboard.stripe.com/apikeys
# Use sk_test_* for development, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Endpoint: https://garcar-payments.up.railway.app/stripe-webhook
# Required events: checkout.session.completed, invoice.paid,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Stripe Price IDs ──────────────────────────────────────────────────────
# One-time public landing-page offers
# Create at https://dashboard.stripe.com/products → one-time payment
STRIPE_PRICE_AUDIT=price_xxx
STRIPE_PRICE_DEALDESK=price_xxx

# Recurring SaaS / managed automation offers (monthly subscription)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL of this service (no trailing slash)
APP_BASE_URL=https://garcar-payments.up.railway.app

# PostgreSQL connection string (Railway provides this automatically)
# Falls back to SQLite (sqlite:///./local.db) when unset
DATABASE_URL=******host:5432/dbname

# Comma-separated list of allowed CORS origins, or * to allow all
CORS_ALLOW_ORIGINS=*

# Port the server listens on (Railway injects $PORT automatically)
PORT=8000
