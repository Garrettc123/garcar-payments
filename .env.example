# garcar-payments environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# Canonical secret names must match GitHub Actions repository secrets exactly.
# See SECRETS.md for the full authoritative list.

# ── Required ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Stripe price IDs (required for checkout) ──────────────────────────────
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_DEALDESK=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ── App ────────────────────────────────────────────────────────────────────
APP_BASE_URL=
DATABASE_URL=
CORS_ALLOW_ORIGINS=
ENVIRONMENT=development
PORT=8000

# ── Signed-download HMAC secret (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
DOWNLOAD_SIGNING_SECRET=

# ── Email delivery (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Supabase (optional) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Linear (optional) ──────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ── Notion (optional) ──────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_REVENUE_DB_ID=
