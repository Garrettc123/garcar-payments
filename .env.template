# ═══════════════════════════════════════════════════════
# Garcar Enterprise — Payment Engine Environment Config
# Copy to .env and fill in real values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════

# ── Stripe ─────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY

# Get from: https://dashboard.stripe.com/webhooks
# Webhook events to enable:
#   customer.subscription.created
#   customer.subscription.deleted
#   invoice.paid
#   invoice.payment_failed
#   checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ── MARS API Stripe Price IDs (recurring monthly) ──────
# Create at: https://dashboard.stripe.com/products
# Click "Add product" → set recurring price → copy Price ID
STRIPE_PRICE_MARS_STARTER=price_REPLACE_STARTER_497
STRIPE_PRICE_MARS_PROFESSIONAL=price_REPLACE_PROFESSIONAL_1497
STRIPE_PRICE_MARS_ENTERPRISE=price_REPLACE_ENTERPRISE_4997
STRIPE_PRICE_MARS_SOVEREIGN=price_REPLACE_SOVEREIGN_14997

# ── Notion ──────────────────────────────────────────────
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_REPLACE_ME
NOTION_REVENUE_DB_ID=0707431dd7594e85956e4340b86e6976
NOTION_CUSTOMER_DB_ID=024f6838e7b745cca1db53db0c4e5fcf

# ── Linear ──────────────────────────────────────────────
# Get from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_REPLACE_ME
LINEAR_TEAM_ID=0a42fa2d-5df2-45f5-a1c2-1dd78749fe93
LINEAR_PROJECT_ID=b403fce1-8b70-4aa1-b5e1-1d48bf0eda4a

# ── Linear State IDs (optional, auto-resolved if blank) ─
LINEAR_STATE_IN_PROGRESS=
LINEAR_STATE_AT_RISK=
LINEAR_STATE_CANCELLED=

# ── Railway Deployment ──────────────────────────────────
